<?xml version="1.0" encoding="UTF-8" ?>
<!-- Test only: localhost UDP DDS transport, no /dev/shm artifacts or hardware peers.
     DDS discovery UDP is unrelated to actuator UDP (which is unimplemented). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>control_test_local_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="control_test" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>control_test_local_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
