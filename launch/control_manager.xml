<?xml version="1.0"?>
<launch>
  <arg name="pipeline_file" default="$(find-pkg-share control_manager)/config/pipeline.yaml"/>
  <arg name="mode" default="test" description="Competition operation configuration">
    <choice value="test"/>
    <choice value="brake_inspection"/>
    <choice value="preliminary_lap"/>
    <choice value="final_lap"/>
  </arg>
  <arg name="params_file" default="$(find-pkg-share control_manager)/config/modes/$(var mode).yaml"
       description="Compatibility alias for operation_file; prefer operation_file for new invocations"/>
  <arg name="operation_file" default="$(var params_file)"/>
  <arg name="mission_file" default="$(find-pkg-share control_manager)/config/mission.yaml"/>
  <arg name="control_file" default="$(find-pkg-share control_manager)/config/control.yaml"/>
  <arg name="vehicle_file" default="$(find-pkg-share control_manager)/config/vehicle.yaml"/>
  <arg name="map_file" default=""
       description="Global map JSON path override; empty keeps the selected mode map_file"/>
  <!-- measured stop observation shared with manual tests. -->
  <arg name="stop_speed_mps" default="0.1"/>
  <arg name="stop_hold_s" default="0.5"/>
  <node pkg="vehicle_recorder" exec="stop_observer" name="stop_monitor" namespace="/control" output="screen">
    <!-- fixed /control/actuator_raw, /gnss/odom and /control/stop_status
         are replaced by common pipeline/operation wiring. -->
    <param from="$(var pipeline_file)"/>
    <param from="$(var operation_file)"/>
    <param name="stop_speed_mps" value="$(var stop_speed_mps)" type="float"/>
    <param name="stop_hold_s" value="$(var stop_hold_s)" type="float"/>
  </node>
  <node pkg="control_manager" exec="global_path_provider" name="global_path_provider" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var operation_file)"/>
    <param name="map_file_override" value="$(var map_file)" type="str"/>
  </node>
  <node pkg="control_manager" exec="sensor_interface_node" name="sensor_interface" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var operation_file)"/>
  </node>
  <node pkg="control_manager" exec="global_state_estimator" name="global_state_estimator" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var operation_file)"/>
  </node>
  <node pkg="control_manager" exec="lane_state_estimator" name="lane_state_estimator" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var operation_file)"/>
  </node>
  <node pkg="control_manager" exec="path_planning_node" name="path_planning" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var operation_file)"/>
  </node>
  <node pkg="control_manager" exec="object_manager_node" name="object_manager" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var operation_file)"/>
  </node>
  <node pkg="control_manager" exec="mission_based_limit_node" name="mission_based_limit" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var operation_file)"/>
  </node>
  <node pkg="control_manager" exec="motion_planning_node" name="motion_planning" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var operation_file)"/>
  </node>
  <node pkg="control_manager" exec="motion_control_node" name="motion_control" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var control_file)"/>
    <param from="$(var operation_file)"/>
  </node>
  <node pkg="control_manager" exec="control_selector_node" name="control_selector" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var operation_file)"/>
  </node>
  <node pkg="control_manager" exec="vehicle_interface_node" name="vehicle_interface" namespace="/control" output="screen">
    <param from="$(var vehicle_file)"/>
    <param from="$(var pipeline_file)"/>
    <param from="$(var mission_file)"/>
    <param from="$(var operation_file)"/>
  </node>
</launch>
