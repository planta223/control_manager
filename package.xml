<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>control_manager</name>
  <version>0.6.0</version>
  <description>Upper control architecture with a single observation/feedback ingress, global_state_estimator and lane_state_estimator with separate GlobalPose/MotionState, GPS/LANE/HYBRID planning contracts, Pure Pursuit, control_selector and protected trans-compatible actuator output inside vehicle_interface.</description>
  <maintainer email="sukyun02@users.noreply.github.com">baqu4</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>encoder_motor</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
